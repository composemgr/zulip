# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=zulip.example.com

# Database (PostgreSQL)
DB_CREATE_DATABASE_NAME=zulip
DB_USER_NAME=zulip
DB_USER_PASS=replace-with-a-random-password

# Service passwords for the internal datastores
MEMCACHED_PASS=replace-with-a-random-password
REDIS_PASS=replace-with-a-random-password

# Signs sessions and API tokens, 32 characters or longer
APP_SECRET_KEY=replace-with-a-random-32-byte-hex-string

# First user created on an empty database
APP_ADMIN_USER=admin

# Outbound email for notifications and invites
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=587
EMAIL_SERVER_LOGIN_NAME=
EMAIL_SERVER_LOGIN_PASS=
EMAIL_SERVER_MAIL_FROM=noreply@example.com
